# Chip Chat — copy to .env and fill in (never commit .env)
OPENROUTER_CC_API_KEY=

# Offline smoke / CI-style runs without OpenRouter
# CHIP_CHAT_MOCK=1

# Optional: override JSONL ledger location (default: ~/appdata/chip-chat)
# CHIP_CHAT_DATA_DIR=

# Boot only. Runtime Discord token and webhooks are fetched from Infisical.
# INFISICAL_API_URL=https://infisical.razzormail.com
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# CHIP_RELAY_AUTO=false
# Tool execution (Phase 4): default gated; pass CLI --execute or enable auto:
# CHIP_TOOL_AUTO=false
# Layer 3 selftest (live OpenRouter; persona from rooms.json speakers, not forced --as pm):
# CHIP_RELAY_SELFTEST=1
# CHIP_RELAY_SELFTEST_AUTHOR_ID=1553182793041838141
# CHIP_RELAY_SELFTEST_AUTHOR_HANDLE=
# CHIP_RELAY_SELFTEST_ROOM=selftest
# Alternative author (human): CHIP_RELAY_SELFTEST_AUTHOR_ID=187044496872046592 when mapped in room speakers
