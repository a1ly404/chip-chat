# Chip Chat — copy to .env and fill in (never commit .env)
OPENROUTER_CC_API_KEY=

# Offline smoke / CI-style runs without OpenRouter
# CHIP_CHAT_MOCK=1

# Optional: override JSONL ledger location (default: ~/appdata/chip-chat)
# CHIP_CHAT_DATA_DIR=

# Relay skeleton. Token and webhook values live in Infisical, not in git.
# CHIP_RELAY_AUTO=false
# DISCORD_CHIP_RELAY_TOKEN=
# DISCORD_CHIP_RELAY_WEBHOOK_PM=
# DISCORD_CHIP_RELAY_WEBHOOK_DEV=
# DISCORD_CHIP_RELAY_WEBHOOK_TESTER=
