# Chip Chat engine — copy to .env and fill in (never commit .env)
OPENROUTER_CC_API_KEY=

# Offline smoke / CI without OpenRouter
# CHIP_CHAT_MOCK=1

# Ledger + threads (default under $HOME/.local/share/chip-chat for acme-example)
# CHIP_CHAT_DATA_DIR=

# System pack (default example ships with acme-example)
# CHIP_SYSTEM_PACK=acme-example
# CHIP_PACK_DIR=
# CHIP_PLUGINS=

# Relay (values from your secret store)
# DISCORD_CHIP_RELAY_TOKEN=
# CHIP_WEBHOOK_DEV=
# CHIP_WEBHOOK_SELFTEST=
# CHIP_RELAY_AUTO=false
# CHIP_RELAY_INJECT_BOT_IDS=
# CHIP_RELAY_INJECT_AUTHOR_ID=
# CHIP_TOOL_AUTO=false
