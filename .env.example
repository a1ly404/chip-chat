# Chip Chat engine — copy to .env and fill in (never commit .env)
OPENROUTER_CC_API_KEY=

# Offline smoke / CI without OpenRouter
# CHIP_CHAT_MOCK=1

# Monthly OpenRouter budget (docs/BUDGET_MODES.md). Defaults shown; set only to override.
# CHIP_SPEND_CAP_USD=5.00          # HARD STOP: live model calls refused at/above this
# CHIP_SPEND_THRIFT_PCT=0.80       # thrift mode (cheap model, read-only) from 80% of the cap
# CHIP_THRIFT_MODEL=qwen/qwen3.7-flash
# CHIP_THRIFT_MAX_TOKENS=256
# CHIP_THRIFT_REPLY_CHARS=600

# Ledger + threads (default under $HOME/.local/share/chip-chat for acme-example)
# CHIP_CHAT_DATA_DIR=
#CHIP_SPEND_PIN_DATA_DIR=0     # slice B: 1 = live calls refuse unless CHIP_CHAT_DATA_DIR is absolute

# System pack (default example ships with acme-example)
# CHIP_SYSTEM_PACK=acme-example
# CHIP_PACK_DIR=
# CHIP_PLUGINS=

# Relay (values from your secret store)
# DISCORD_CHIP_RELAY_TOKEN=
# CHIP_WEBHOOK_RELAY=   # #chip-relay (system notices, beats); falls back to DEV
# CHIP_WEBHOOK_DEV=
# CHIP_WEBHOOK_SELFTEST=
# CHIP_RELAY_AUTO=false
# CHIP_RELAY_INJECT_BOT_IDS=
# CHIP_RELAY_INJECT_AUTHOR_ID=
# CHIP_TOOL_AUTO=false
# CHIP_RECIPE_EXEC=0          # default off; 1 = registry-only non-mutating grounded recipe go
# CHIP_HOST_EXEC=0            # host-exec seam: 1 = relay wiring allowed; executions stay plugin-side, engine is always dry-run
# CHIP_ALERT_GROUNDING=0      # slice E: 1 = alert->recipe-id grounding permitted for turn wiring
# CHIP_POST_TURN_WORKER=0     # slice G: 1 = bounded persisted post-turn worker allowed for relay wiring
# CHIP_WORKER_MAX_ACTIVE=2        # jobs started per tick (cap 8)
# CHIP_WORKER_TIMEOUT_S=30        # per-job wall clock (cap 120)
# CHIP_WORKER_MAX_QUEUE_DEPTH=32  # queued jobs visible to a tick (cap 256)
